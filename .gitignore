# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but the template must be committed, since .env* above would hide it
!.env.local.example

# secrets beyond env files
*.key
*.p12
*.pfx

# extra build output
.turbo/
/dist

# Downloaded planetary textures. The manifest and fetch script are the artifact, not the
# bytes; run `npm run assets 1` to restore them. Tier 2 and 3 run to several GB.
/public/textures/

# Visual verification output. Regenerate with `npm run visual`.
/artifacts/
