# The AI mission-control panel needs this. Everything else in the app works without it.
# Copy to .env.local (gitignored) and fill in. Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. api.nasa.gov DEMO_KEY is capped at 10 requests, measured, so get a free key
# at https://api.nasa.gov if you want the live near-Earth-object feed.
NASA_API_KEY=DEMO_KEY
