{
  "name": "solar",
  "version": "0.1.0",
  "private": true,
  "description": "A physically rigorous solar system simulator. One engine, many clients.",
  "workspaces": [
    "engine",
    "website"
  ],
  "scripts": {
    "dev": "npm run dev --workspace website",
    "build": "npm run build --workspace website",
    "start": "npm run start --workspace website",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace engine && npm run typecheck --workspace website",
    "verify": "vitest run",
    "check": "bash scripts/check.sh",
    "verify:ephemeris": "vitest run engine/src/kepler.test.ts",
    "verify:relativity": "vitest run engine/src/relativity.test.ts",
    "verify:physics": "vitest run engine/src/demonstrations",
    "verify:contracts": "vitest run engine/src/bodies",
    "verify:propagate": "vitest run engine/src/propagate.test.ts",
    "verify:asteroid": "vitest run engine/src/scenarios",
    "verify:ascent": "vitest run engine/src/launch",
    "verify:nbody": "vitest run engine/src/nbody.test.ts engine/src/nbody-tracker.test.ts",
    "verify:ai-tools": "vitest run website/src/ai",
    "verify:invariants": "vitest run website/src/view/core/invariants.test.ts",
    "verify:depth": "vitest run website/src/view/core/depth.test.ts",
    "verify:tiles": "vitest run website/src/view/core/tiles.test.ts",
    "assets": "npm run assets --workspace website",
    "assets:list": "npm run assets:list --workspace website",
    "stars": "npm run stars --workspace website",
    "terrain": "npm run terrain --workspace website",
    "visual": "npm run visual --workspace website",
    "visual:nbody": "npm run visual:nbody --workspace website",
    "visual:views": "npm run visual:views --workspace website",
    "verify:relief": "npm run verify:relief --workspace website",
    "visual:hide": "npm run visual:hide --workspace website"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
