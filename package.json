{
  "name": "solar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:relativity": "vitest run src/engine/relativity.test.ts",
    "verify:ephemeris": "vitest run src/engine/kepler.test.ts",
    "verify:physics": "vitest run src/engine/demonstrations",
    "verify": "vitest run",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:list": "node scripts/fetch-assets.mjs --list",
    "stars": "node scripts/build-star-catalogue.mjs",
    "verify:contracts": "vitest run src/engine/bodies",
    "verify:depth": "vitest run src/view/core/depth.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "camera-controls": "3.1.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
